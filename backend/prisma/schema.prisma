generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  role              Role      @default(PLAYER)
  createdAt         DateTime  @default(now())
  verified          Boolean   @default(false)
  // Both tokens are stored as SHA-256 hashes (src/utils/tokens.js hashToken); the
  // email link carries the original random token.
  verifyToken        String?
  verifyTokenExpires DateTime?
  resetToken         String?
  resetTokenExpires  DateTime?
  // Every login token carries this number (the `tv` claim). Increasing it cancels all
  // of the account's tokens, which logs it out on every device (DECISIONS.md 2026-11-20).
  tokenVersion       Int       @default(0)

  playerProfile PlayerProfile?
  ownerProfile  OwnerProfile?

  // Teams this user captains (Team.captainId). The captain is stored only there
  // (DECISIONS.md 2026-11-18); they are also an accepted TeamMember of the team.
  captainedTeams Team[]       @relation("CaptainedTeams")
  teamMembers    TeamMember[]

  @@index([verifyToken])
  @@index([resetToken])
}

model PlayerProfile {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  name     String
  phone    String
  position String
  height   Float?
  weight   Float?
  address  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  indoorName  String
  phone       String
  address     String
  description String?
  website     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  captainId   Int
  createdAt   DateTime     @default(now())
  // Restrict: a user who still captains a team can't be deleted until the team is
  // handed over or deleted (the account deletion feature does that handover).
  captain     User         @relation("CaptainedTeams", fields: [captainId], references: [id], onDelete: Restrict)
  members     TeamMember[]

  @@index([captainId])
}

model TeamMember {
  id         Int              @id @default(autoincrement())
  teamId     Int
  userId     Int
  status     MembershipStatus @default(pending)
  // How the membership started: the captain's invite, the player's join request, or
  // the captain's own row, created with the team.
  origin     MembershipOrigin
  // When the invite, request or team was created (not when the player joined).
  createdAt  DateTime         @default(now())
  // When the membership became accepted; null while pending. "Longest-standing member"
  // is the earliest acceptedAt, ties to the lower id (DECISIONS.md 2026-11-18).
  acceptedAt DateTime?
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, status])
}

// Lowercase on purpose: the old text values convert directly, and API replies and the
// app keep showing the same status text.
enum MembershipStatus {
  pending
  accepted
}

enum MembershipOrigin {
  invite
  request
  creator
}

enum Role {
  PLAYER
  OWNER
  ADMIN
}
