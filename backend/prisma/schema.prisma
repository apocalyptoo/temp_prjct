generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  role              Role      @default(PLAYER)
  createdAt         DateTime  @default(now())
  verified          Boolean   @default(false)
  // Both tokens are stored as SHA-256 hashes (src/utils/tokens.js hashToken); the
  // email link carries the original random token.
  verifyToken        String?
  verifyTokenExpires DateTime?
  resetToken         String?
  resetTokenExpires  DateTime?
  // Every login token carries this number (the `tv` claim). Increasing it cancels all
  // of the account's tokens, which logs it out on every device (DECISIONS.md 2026-11-20).
  tokenVersion       Int       @default(0)

  playerProfile PlayerProfile?
  ownerProfile  OwnerProfile?

  ownedTeams  Team[]       @relation("OwnedTeams")
  teamMembers TeamMember[]

  @@index([verifyToken])
  @@index([resetToken])
}

model PlayerProfile {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  name     String
  phone    String
  position String
  height   Float?
  weight   Float?
  address  String?

  user User @relation(fields: [userId], references: [id])
}

model OwnerProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  indoorName  String
  phone       String
  address     String
  description String?
  website     String?

  user User @relation(fields: [userId], references: [id])
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  ownerId     Int
  createdAt   DateTime     @default(now())
  owner       User         @relation("OwnedTeams", fields: [ownerId], references: [id])
  members     TeamMember[]
}

model TeamMember {
  id       Int      @id @default(autoincrement())
  teamId   Int
  userId   Int
  role     String   @default("player")
  status   String   @default("pending")
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

enum Role {
  PLAYER
  OWNER
  ADMIN
}
