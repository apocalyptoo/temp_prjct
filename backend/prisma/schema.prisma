generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  role              Role      @default(PLAYER)
  createdAt         DateTime  @default(now())
  verified          Boolean   @default(false)
  // Both tokens are stored as SHA-256 hashes (src/utils/tokens.js hashToken); the
  // email link carries the original random token.
  verifyToken        String?
  verifyTokenExpires DateTime?
  resetToken         String?
  resetTokenExpires  DateTime?
  // Every login token carries this number (the `tv` claim). Increasing it cancels all
  // of the account's tokens, which logs it out on every device (DECISIONS.md 2026-11-20).
  tokenVersion       Int       @default(0)
  // When the user ticked "I agree to the Terms of Use and Privacy Policy" at sign-up.
  // Null for accounts made before the checkbox existed (all test data) and for the
  // admin made by the script (docs/features/profiles-and-registration.md, P7).
  termsAcceptedAt    DateTime?

  playerProfile PlayerProfile?
  ownerProfile  OwnerProfile?

  // Teams this user captains (Team.captainId). The captain is stored only there
  // (DECISIONS.md 2026-11-18); they are also an accepted TeamMember of the team.
  captainedTeams Team[]       @relation("CaptainedTeams")
  teamMembers    TeamMember[]

  @@index([verifyToken])
  @@index([resetToken])
}

model PlayerProfile {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  name     String
  phone    String
  position Position
  height   Float?
  weight   Float?
  // The player's general area ("Dhanmondi 27"), never a full address. Public to
  // logged-in users (docs/PRODUCT.md, "Profiles" and "Profile visibility").
  area     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  indoorName  String
  // Optional since the short owner sign-up: filled in later on My Venue.
  phone       String?
  address     String?
  description String?
  website     String?
  // The rest of the listing (docs/features/venues.md, section c). Area follows the
  // player Area rules; opening hours and pricing info are short plain text.
  area         String?
  openingHours String?
  pricingInfo  String?
  // Admin review: null means "Pending review" (hidden from discovery), a date means
  // live since then (spec P4). There's no rejected state.
  approvedAt   DateTime?
  // The admin's note to the owner, shown on My Venue while the venue is pending
  // (spec P2, P5). Cleared when the venue is approved.
  reviewNote   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvedAt])
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  captainId   Int
  createdAt   DateTime     @default(now())
  // Restrict: a user who still captains a team can't be deleted until the team is
  // handed over or deleted (the account deletion feature does that handover).
  captain     User         @relation("CaptainedTeams", fields: [captainId], references: [id], onDelete: Restrict)
  members     TeamMember[]

  @@index([captainId])
}

model TeamMember {
  id         Int              @id @default(autoincrement())
  teamId     Int
  userId     Int
  status     MembershipStatus @default(pending)
  // How the membership started: the captain's invite, the player's join request, or
  // the captain's own row, created with the team.
  origin     MembershipOrigin
  // When the invite, request or team was created (not when the player joined).
  createdAt  DateTime         @default(now())
  // When the membership became accepted; null while pending. "Longest-standing member"
  // is the earliest acceptedAt, ties to the lower id (DECISIONS.md 2026-11-18).
  acceptedAt DateTime?
  // A join request's optional message to the captain (at most 150 characters, trimmed;
  // blank is stored as null). Only on pending join requests: approving clears it, and
  // rejecting or cancelling deletes the row. Seen only by the captain, the requester and
  // the admin (docs/PRODUCT.md, "Team membership").
  message    String?
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, status])
}

// Lowercase on purpose: the old text values convert directly, and API replies and the
// app keep showing the same status text.
enum MembershipStatus {
  pending
  accepted
}

enum MembershipOrigin {
  invite
  request
  creator
}

// Spelled exactly as the app shows them; the API sends and accepts these words
// (docs/features/profiles-and-registration.md, P1).
enum Position {
  Goalkeeper
  Defender
  Midfielder
  Forward
  Any
}

enum Role {
  PLAYER
  OWNER
  ADMIN
}
