# Copy this file to .env (in this backend/ folder) and fill in real values.
# Never commit .env. Every value below is a fake placeholder.

# PostgreSQL connection used by Prisma: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/connect_arena?schema=public"

# Secret used to sign login tokens (JWTs). Use a long random string, for example the
# output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Gmail account that sends verification and password-reset emails.
# EMAIL_PASS is a Gmail App Password (Google Account > Security > App passwords),
# not the account's normal password.
EMAIL_USER="your-address@gmail.com"
EMAIL_PASS="abcd efgh ijkl mnop"

# The backend's public address, used to build the links in those emails.
# While developing this is your ngrok URL (or http://localhost:4000 on this PC only).
BACKEND_PUBLIC_URL="https://your-tunnel-name.ngrok-free.dev"

# Optional: the port the server listens on (default 4000).
# PORT=4000

# Only needed when running `node scripts/createAdmin.js` (creates the admin account or
# changes its password). The password must pass the same strength rule as registration
# (8+ characters with upper and lower case, a number and a symbol). Left empty on purpose:
# the script refuses to run until you fill them in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional, tests only: the server the tests talk to (default http://localhost:PORT).
# TEST_BASE_URL=http://localhost:4000
